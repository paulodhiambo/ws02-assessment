# Dev environment: the local docker-compose stack. Sourced by scripts/*.sh
# and the Jenkins pipeline. No secrets here; real credentials come from the
# environment (Jenkins credentials) and override these defaults.

ENV_NAME=dev

# Micro Integrator
MI_CONTAINER_SERVICE=mi                      # docker compose service to deploy into
MI_HOME=/home/wso2carbon/wso2mi-4.6.0
MI_BASE_URL=http://localhost:8290            # API traffic
MI_MGMT_URL=https://localhost:9164/management
MI_DEPLOY_TIMEOUT_SECONDS=120

# API Manager (apictl environment)
APICTL_ENV=dev
APIM_URL=https://localhost:9443
APIM_GATEWAY_URL=https://localhost:8243
# Backend URL the APIM gateway uses to reach MI (container-to-container)
MI_BACKEND_FOR_APIM=http://mi:8290

# Backends used by MI in dev
CUSTOMER_BACKEND_URL=https://jsonplaceholder.typicode.com
LOAN_SOAP_BACKEND_URL=http://www.dneonline.com/calculator.asmx
