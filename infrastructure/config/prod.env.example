# Prod environment template. Copy to prod.env (git-ignored) on the deploy
# agent. Not wired to a real environment in this assignment; the pipeline's
# prod stage reads this file to show how promotion would work.

ENV_NAME=prod

MI_CONTAINER_SERVICE=                        # n/a in prod: CARs go through the MI management API / image build
MI_HOME=/home/wso2carbon/wso2mi-4.6.0
MI_BASE_URL=https://mi.internal.jamiisavings.example:8253
MI_MGMT_URL=https://mi.internal.jamiisavings.example:9164/management
MI_DEPLOY_TIMEOUT_SECONDS=300

APICTL_ENV=prod
APIM_URL=https://apim.jamiisavings.example
APIM_GATEWAY_URL=https://api.jamiisavings.example
MI_BACKEND_FOR_APIM=https://mi.internal.jamiisavings.example:8253

# Prod would use the bank's real customer and loan systems, not public test services.
CUSTOMER_BACKEND_URL=https://customer-service.internal.jamiisavings.example
LOAN_SOAP_BACKEND_URL=https://loan-engine.internal.jamiisavings.example/eligibility.asmx
