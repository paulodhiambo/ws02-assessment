<?xml version="1.0" encoding="UTF-8"?>
<!--
  Read-only access to the accounts table. Invoked in-process by
  AccountBalanceAPI through the dataServiceCall mediator.

  Connection details are injected from environment variables at deploy time
  ($SYSTEM:...), so the same artifact runs unchanged in dev and prod.
  The query uses a bound parameter; the account number is never concatenated
  into SQL.
-->
<data name="AccountsDataService" serviceNamespace="http://ds.jamiisavings.co.ke/accounts"
      transports="http https" disableStreaming="true" enableBatchRequests="false" enableBoxcarring="false">
    <description>Jamii Savings account lookup (read-only)</description>
    <config id="AccountsDB">
        <property name="driverClassName">com.mysql.cj.jdbc.Driver</property>
        <property name="url">$SYSTEM:ACCOUNTS_DB_URL</property>
        <property name="username">$SYSTEM:ACCOUNTS_DB_USER</property>
        <property name="password">$SYSTEM:ACCOUNTS_DB_PASSWORD</property>
        <property name="initialSize">0</property>
        <property name="minIdle">0</property>
        <property name="maxActive">20</property>
        <property name="maxWait">3000</property>
        <property name="testOnBorrow">true</property>
        <property name="validationQuery">SELECT 1</property>
        <property name="validationInterval">10000</property>
    </config>
    <query id="getAccountByNumber" useConfig="AccountsDB">
        <sql>SELECT account_number, status, balance, currency FROM accounts WHERE account_number = ?</sql>
        <param name="accountNumber" sqlType="STRING" type="IN" ordinal="1"/>
        <result element="accounts" rowName="account" defaultNamespace="http://ds.jamiisavings.co.ke/accounts">
            <element column="account_number" name="accountNumber" xsdType="string"/>
            <element column="status" name="status" xsdType="string"/>
            <element column="balance" name="amount" xsdType="decimal"/>
            <element column="currency" name="currency" xsdType="string"/>
        </result>
    </query>
    <!--
      Used by the customer dashboard (bonus A). MySQL builds the JSON array
      itself, so MI can embed it as-is with no XML-to-JSON array conversion
      issues (single-element arrays, leading-zero account numbers read as numbers).
    -->
    <query id="getAccountsByCustomer" useConfig="AccountsDB">
        <sql>SELECT COALESCE(JSON_ARRAYAGG(JSON_OBJECT('accountNumber', account_number, 'type', account_type, 'status', status, 'balance', JSON_OBJECT('amount', balance, 'currency', currency))), JSON_ARRAY()) AS accounts_json FROM accounts WHERE customer_id = ?</sql>
        <param name="customerId" sqlType="STRING" type="IN" ordinal="1"/>
        <result element="customerAccounts" rowName="row" defaultNamespace="http://ds.jamiisavings.co.ke/accounts">
            <element column="accounts_json" name="accountsJson" xsdType="string"/>
        </result>
    </query>
    <operation name="getAccountsByCustomer">
        <call-query href="getAccountsByCustomer">
            <with-param name="customerId" query-param="customerId"/>
        </call-query>
    </operation>
    <operation name="getAccountByNumber">
        <call-query href="getAccountByNumber">
            <with-param name="accountNumber" query-param="accountNumber"/>
        </call-query>
    </operation>
</data>
