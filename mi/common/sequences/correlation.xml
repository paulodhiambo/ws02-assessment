<?xml version="1.0" encoding="UTF-8"?>
<!--
  Establishes request identity for every API call.

  - REQUEST_ID:     generated per MI request; returned in the response body/header.
  - CORRELATION_ID: taken from the caller's X-Correlation-ID header when it is
                    present and well-formed, otherwise generated. Propagated to
                    backends and echoed back to the caller.

  The caller-supplied value is format-checked before use so it cannot inject
  content into logs or downstream headers.
-->
<sequence name="correlation" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <property name="REQUEST_START" expression="get-property('SYSTEM_TIME')" scope="default" type="STRING"/>
    <property name="REQUEST_ID" expression="substring-after(get-property('MessageID'), 'urn:uuid:')" scope="default" type="STRING"/>
    <!-- Messages from inbound endpoints (e.g. RabbitMQ) have no HTTP MessageID: generate a v4 UUID. -->
    <filter xpath="string-length(get-property('REQUEST_ID')) = 0">
        <then>
            <script language="js"><![CDATA[
                var hex = "0123456789abcdef", id = "";
                for (var i = 0; i < 36; i++) {
                    id += (i === 8 || i === 13 || i === 18 || i === 23) ? "-"
                        : (i === 14) ? "4"
                        : (i === 19) ? hex.charAt(8 + Math.floor(Math.random() * 4))
                        : hex.charAt(Math.floor(Math.random() * 16));
                }
                mc.setProperty("REQUEST_ID", id);
            ]]></script>
        </then>
    </filter>
    <property name="CORRELATION_ID" expression="$trp:X-Correlation-ID" scope="default" type="STRING"/>
    <filter source="get-property('CORRELATION_ID')" regex="[A-Za-z0-9._\-]{8,64}">
        <then/>
        <else>
            <property name="CORRELATION_ID" expression="get-property('REQUEST_ID')" scope="default" type="STRING"/>
        </else>
    </filter>
    <header name="X-Correlation-ID" scope="transport" expression="get-property('CORRELATION_ID')"/>
</sequence>
