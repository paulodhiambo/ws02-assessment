  "item": [
    {
      "name": "accounts",
      "item": [
        {
          "name": "balance - active account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('correlation id returned', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.be.a('string').and.not.empty);",
                  "const b = pm.response.json();",
                  "pm.test('spec envelope', () => {",
                  "  pm.expect(b).to.have.all.keys('accountNumber', 'status', 'balance', 'requestId', 'timestamp');",
                  "  pm.expect(b.status).to.be.oneOf(['ACTIVE', 'DORMANT', 'CLOSED']);",
                  "  pm.expect(b.balance.amount).to.be.a('number');",
                  "  pm.expect(b.balance.currency).to.eql('KES');",
                  "  pm.expect(new Date(b.timestamp).toString()).to.not.eql('Invalid Date');",
                  "});",
                  "pm.test('caller correlation id kept', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.match(/postman-acc-0001$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "apikey",
                "value": "{{apiKey}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-acc-0001"
              }
            ],
            "url": "{{accountsUrl}}/0100000001/balance"
          }
        },
