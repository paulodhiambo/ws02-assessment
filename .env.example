# Copy to .env and adjust. docker-compose reads .env automatically.

# --- Accounts database (MySQL) ---
MYSQL_ROOT_PASSWORD=change-me-root
ACCOUNTS_DB_NAME=jamii_accounts
ACCOUNTS_DB_USER=jamii_app
ACCOUNTS_DB_PASSWORD=change-me-app

# --- Backends used by Micro Integrator ---
# Customer proxy backend: public JSONPlaceholder (default) or local mock (http://customer-mock:3000)
CUSTOMER_BACKEND_URL=https://jsonplaceholder.typicode.com
# Loan eligibility SOAP backend: public DNE Online calculator (default) or local mock (http://soap-mock:8088/calculator.asmx)
LOAN_SOAP_BACKEND_URL=http://www.dneonline.com/calculator.asmx

# --- WSO2 ---
MI_ADMIN_USER=admin
MI_ADMIN_PASSWORD=admin
APIM_ADMIN_USER=admin
APIM_ADMIN_PASSWORD=admin
